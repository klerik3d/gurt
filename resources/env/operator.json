  // Digest = node:26-bookworm-slim (current LTS) as of 2026-10-29; bump deliberately with gurt
  // releases (`docker manifest inspect node:26-bookworm-slim`). Debian
  // rather than alpine: gurt's node runtime is a glibc build.
  "image": "node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9"
