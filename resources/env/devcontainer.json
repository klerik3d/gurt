{
  // The bundled default operator environment
  // (docs/requirements-session-operator.md §2.2). Image-only and pinned by
  // digest — no build section, no repo, no features. The image already carries
  // node and npm, so the node feature the container model injects into every
  // other env is not injected here (`devcontainerUp`, keyed on this env's
  // name): it would install a second, newer Node that needs libatomic.so.1,
  // which this slim image lacks. Minimal on purpose: it holds
  // an agent CLI (installed lazily, like every session's adapter) and nothing
  // else, because everything it would otherwise need is on the host side of
  // an MCP call.
  //
  // Digest = node:26-bookworm-slim (current LTS) as of 2026-10-29; bump deliberately with
  // gurt releases (`docker manifest inspect node:26-bookworm-slim`). Debian
  // rather than alpine so that, should the node feature ever be wanted here,
  // it installs via bash/apt and does not hit musl.
  "image": "node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9"
}
