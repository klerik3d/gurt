# Supply-chain hardening: never run npm lifecycle scripts (preinstall/
# postinstall/...) automatically — a compromised dependency must not execute
# code on install. Packages that genuinely need their install scripts are
# allow-listed in package.json under lavamoat.allowScripts and run explicitly
# via `npx allow-scripts` (see the "setup" script).
ignore-scripts=true

# Enforce the "engines" range from package.json (node >=22, npm >=9) — fail
# fast on an unsupported toolchain instead of producing a lockfile drift.
engine-strict=true
