{
  "name": "gurt",
  "version": "0.1.0",
  "description": "Local-first manager for dev environments and coding agents",
  "main": "out/main/index.js",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --mac --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "coverage": "node scripts/coverage.mjs",
    "smoke": "node scripts/run-smoke.mjs",
    "setup": "npm ci && npx allow-scripts"
  },
  "lavamoat": {
    "allowScripts": {
      "electron": true,
      "esbuild#0.25.12": true,
      "vite>esbuild#0.28.2": true,
      "electron-builder>app-builder-lib>electron-builder-squirrel-windows>electron-winstaller": false,
      "rollup>fsevents": false,
      "vite>fsevents": false
    }
  },
  "dependencies": {
    "@devcontainers/cli": "0.88.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "^3.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lavamoat/allow-scripts": "^5.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "diff": "^9.0.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6"
  }
}
